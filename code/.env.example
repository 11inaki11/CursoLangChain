# Copy this file to .env and fill in the key(s) of the provider(s) you use.

# Which model drives the robots. Format: "<provider>:<model>"
#   google_genai:gemini-3.7-flash | openai:gpt-5.5 | anthropic:claude-sonnet-5
#   deepseek:deepseek-chat | mistralai:mistral-large-latest | ollama:qwen3:8b
ROBOT_MODEL=google_genai:gemini-3.7-flash

# Embeddings for RAG (chapter 2c). Claude and DeepSeek have no embeddings API:
# use Gemini, OpenAI or a local Ollama model here.
#   google_genai:gemini-embedding-001 | openai:text-embedding-3-small | ollama:nomic-embed-text
EMBEDDINGS_MODEL=google_genai:gemini-embedding-001

GOOGLE_API_KEY=        # https://aistudio.google.com/apikey
OPENAI_API_KEY=        # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=     # https://console.anthropic.com/settings/keys
DEEPSEEK_API_KEY=      # https://platform.deepseek.com/api_keys
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys

# Local model through Ollama (e.g. via an SSH tunnel to a GPU server:
#   ssh -N -L 11434:localhost:11434 user@gpu-server)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=ollama:qwen3:8b
