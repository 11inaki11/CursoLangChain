# Copy this file to .env and fill in ONLY the key(s) you have.
# Leave the others empty. Keep comments on their own lines: python-dotenv
# would read "KEY=   # comment" as a key whose value is the comment.

# Which model drives the robots, as "<provider>:<model>".
# Leave it empty and it is picked automatically from the key you set below.
# Examples: google_genai:gemini-3.7-flash | deepseek:deepseek-chat | openai:gpt-5.5
#           anthropic:claude-sonnet-5 | mistralai:mistral-large-latest | ollama:qwen3:8b
ROBOT_MODEL=

# Embeddings for RAG (chapter 2c). Leave it empty: Gemini or OpenAI embeddings
# are used if you have that key, otherwise a local keyword search that needs no key.
# Examples: google_genai:gemini-embedding-001 | openai:text-embedding-3-small | ollama:nomic-embed-text
EMBEDDINGS_MODEL=

# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Local model through Ollama. Run "ollama pull qwen3:8b" first.
# On a remote GPU box, tunnel it:  ssh -N -L 11434:localhost:11434 user@gpu-server
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=ollama:qwen3:8b
